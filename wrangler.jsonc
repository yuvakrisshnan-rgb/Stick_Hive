{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickhive",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stickhive-db",
      "database_id": "9fbfa6ce-b67c-4075-afb6-c251a99ac53a",
      "migrations_dir": "migrations"
    }
  ],
  // r2_buckets removed 2026-09-21: `wrangler deploy` validates every
  // binding against the real Cloudflare account at deploy time (unlike
  // local dev, which tolerates an as-yet-nonexistent bucket) - and R2
  // turns out not to be enabled on this account at all yet (confirmed via
  // `wrangler r2 bucket list`: "Please enable R2 through the Cloudflare
  // Dashboard [code: 10042]"), so this binding hard-failed every deploy
  // attempt with "R2 bucket 'stickhive-product-images' not found [code:
  // 10085]" regardless of anything else in this file. Nothing in the live
  // Worker reads env.PRODUCT_IMAGES today - only backend/storage/r2.ts,
  // itself only called by scripts/upload-product-images-r2.mjs, a local
  // script that has never been run (see DEPLOY_CHECKLIST.md) - so removing
  // it unblocks deployment with no runtime behavior change. Re-add once R2
  // is enabled on the account and the bucket actually exists
  // (`wrangler r2 bucket create stickhive-product-images`).
  // D1 lives in APAC (Singapore). Investigation into a run of 502s found
  // all of them landed on the Marseille (MRS) edge PoP specifically -
  // the farthest point on the globe from APAC - while every successful
  // request in the same window was served from SIN/BOM. Smart Placement
  // measures real request latency and relocates execution near the
  // backend it depends on (D1 here) when that's faster than running at
  // whatever edge node the visitor happens to hit. This needs real
  // traffic data over time to actually start relocating - it will not
  // change behavior on the very next request after deploy.
  "placement": {
    "mode": "smart"
  },
  // Daily cleanup of expired otp_challenges/sessions rows (see
  // backend/db/cleanup.ts and worker/index.ts's `scheduled` export).
  // 03:00 UTC - low-traffic window, arbitrary otherwise; the job is
  // idempotent and can safely run at any time.
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  // Non-sensitive config. AUTH_SECRET and RESEND_API_KEY are set via
  // `wrangler secret put` instead (not committed to the repo).
  //
  // STICKHIVE_UPI_ID and AUTH_FROM_EMAIL are intentionally absent - no
  // real UPI VPA or verified sender domain exists yet. Live UPI checkout
  // will fail with "STICKHIVE_UPI_ID is not configured" until a real one
  // is added here; OTP emails fall back to Resend's shared sandbox
  // sender (onboarding@resend.dev) until AUTH_FROM_EMAIL is set.
  //
  // PRODUCTS_SOURCE=d1: the remote products table (migrations/0006) has
  // been applied and seeded (194 rows, 107 active - see DEPLOY_CHECKLIST.md
  // and DECISIONS.md) as of 2026-09-21, so /shop and checkout
  // (backend/products/catalog.ts) now read the real D1 catalogue in
  // production instead of the static PRODUCTS array fallback. Product
  // images are not part of this - R2 is not yet enabled on this Cloudflare
  // account at all (confirmed via `wrangler r2 bucket list`), so every
  // product still renders its emoji placeholder; that's expected, not a
  // regression, until the R2 step in DEPLOY_CHECKLIST.md actually runs.
  "vars": {
    "AUTH_DEBUG_OTP": "false",
    "STICKHIVE_ADMIN_EMAILS": "yuvakrisshnan@gmail.com",
    "STICKHIVE_UPI_NAME": "Stick Hive",
    "PRODUCTS_SOURCE": "d1"
  }
}
