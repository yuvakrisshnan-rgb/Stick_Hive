# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=stickhive

# Email / OTP
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Stick Hive <noreply@stickhive.app>"
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_DEBUG_OTP=false

# Local Floci / production AWS S3
# Local development: us-east-1 (Floci default)
# Production AWS: ap-south-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=stick-hive
S3_ENDPOINT=http://localhost:4566

# Production: remove S3_ENDPOINT and use an AWS IAM role/temporary credentials.


# Manual UPI checkout
STICKHIVE_UPI_ID=yourupi@bank
STICKHIVE_UPI_NAME=Stick Hive

# Stripe backend remains available for a future gateway integration; launch checkout uses UPI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Admin
# Comma-separated verified account emails allowed to use the admin area.
STICKHIVE_ADMIN_EMAILS=you@example.com
# AUTH_SECRET also derives the private /admin/<32-hex> access path.
# Keep AUTH_SECRET long and random (32+ characters).

# Google Pay Omnichannel API (enable only after Google merchant allowlisting and bank/PSP verification)
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_SERVICE_ACCOUNT_JSON=
